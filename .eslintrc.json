{
    "parser": "@babel/eslint-parser",
    "env": {
      "browser": true,
      "es6": true,
      "jest": true
    },
    "extends": [
      "plugin:react/recommended",
      "standard"
    ],
    "parserOptions": {
      "requireConfigFile": false,
      "babelOptions": {
        "plugins": ["@babel/plugin-syntax-jsx"]
      },
      "ecmaVersion": 2020,
      "sourceType": "module",
      "ecmaFeatures": {
        "jsx": true
      }
    },
    "settings": {
      "react": {
        "version": "detect"
      }
    },
    "plugins": [
      "react"
    ],
    "rules": {
      "semi": [2, "always"],
      "space-before-function-paren": [0, { "anonymous": "always", "named": "always" }],
      "camelcase": 0,
      "no-return-assign": 0
    }
  }
  